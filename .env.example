# ── RentPro environment ───────────────────────────────────────────────────
# Copy to `.env` and fill in. NEVER commit the real .env.

# ---- Database (Prisma) — matches docker-compose.yml ----
DATABASE_URL="postgresql://rentpro:rentpro@localhost:5432/rentpro?schema=public"

# ---- NextAuth (point 2) ----
# A long random string. Generate one:  openssl rand -base64 32
NEXTAUTH_SECRET="change-me-to-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# ---- Owner account (single user seeded at startup) ----
# The owner sees the loaded dump data (org_1). Change these!
OWNER_USERNAME="admin"
OWNER_PASSWORD="admin123"

# ---- Migration pipeline (point 1) ----
# Path to your legacy phpMyAdmin dump (osudlagb_home_rent.sql).
# Can be absolute or relative to the repo root.
LEGACY_SQL_PATH="../rent-project/osudlagb_home_rent.sql"

# ---- Optional: GitHub token (only if scripting against the repo) ----
# GITHUB_TOKEN=""
