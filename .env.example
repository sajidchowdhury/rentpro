# Example environment for RentPro
# Copy to `.env` and fill in real values. NEVER commit the real .env.

# ---- Database (Prisma) ----
# Production (PostgreSQL) — preferred:
DATABASE_URL="postgresql://user:password@localhost:5432/rentpro?schema=public"

# For local SQLite prototyping, comment the line above and uncomment:
# DATABASE_URL="file:./dev.db"
# (also flip provider to "sqlite" in prisma/schema.prisma for the prototype)

# ---- App ----
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# ---- Optional: GitHub token only needed if scripting against the repo ----
# GITHUB_TOKEN=""
